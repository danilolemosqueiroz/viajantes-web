{
  // Site estático (dist/) servido pela Cloudflare. A KingHost continua só como
  // origem das páginas PHP que moram no mesmo domínio (ver worker/index.ts).
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "viajantes-web",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Rotas do React (/cachoeiras, /e/123…) devolvem o index.html.
    "not_found_handling": "single-page-application",
    // Só estes caminhos passam pelo código; o resto sai direto dos arquivos.
    "run_worker_first": [
      "/seja-cliente*",
      "/painel-cliente*",
      "/seja-parceiro*",
      "/parceiros*",
      "/download*",
      "/descontos*",
      "/*.php"
    ]
  },
  "vars": {
    // Hostname que aponta para o MESMO site na KingHost (cadastrar lá como
    // domínio adicional/mapeamento, com SSL). Nunca o próprio viajantesapp.com.br,
    // senão o pedido volta para a Cloudflare em laço.
    "ORIGEM": "https://origem.viajantesapp.com.br"
  },
  "observability": { "enabled": true }
}
